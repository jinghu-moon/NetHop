{
  "name": "@nethop/webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:ui-foundation": "node scripts/dev-ui-foundation.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "npm run test:unit && npm run test:browser && npm run test:e2e",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "playwright test",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "check:imports": "node scripts/check-imports.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:security": "node scripts/check-production-security.mjs",
    "report:release": "node scripts/generate-release-artifacts.mjs",
    "test:quality": "playwright test tests/e2e/release-quality.spec.ts",
    "gate": "npm run typecheck && npm test && npm run build && npm run check:imports && npm run check:dependencies && npm run check:bundle && npm run check:security && npm run report:release"
  },
  "dependencies": {
    "@tabler/icons-vue": "3.46.0",
    "@tanstack/vue-virtual": "3.13.36",
    "@vueuse/core": "14.4.0",
    "kernelsu": "3.0.2",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/browser-playwright": "4.1.11",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "vitest-browser-vue": "2.1.0",
    "vue-tsc": "3.3.10"
  }
}
